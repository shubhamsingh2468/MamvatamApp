{
  "expo": {
    "name": "Mamvatam App",
    "slug": "MamvatamApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-mamvatam.png",
    "scheme": "mamvatamapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/icon-mamvatam.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.shubham2468.MamvatamApp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/dynamic-dna-helix.png",
          "imageWidth": 400,
          "resizeMode": "cover",
          "backgroundColor": "#050515",
          "dark": {
            "backgroundColor": "#050515"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "036a3720-a711-4135-a994-36eea025e940"
      }
    }
  }
}